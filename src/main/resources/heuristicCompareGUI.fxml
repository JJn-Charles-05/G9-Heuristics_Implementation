<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="725.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.MainController">
   <children>
      <Label id="titleLabel" fx:id="titleLabel" layoutX="229.0" layoutY="14.0" text="Heuristics Comparison GUI" />
      <Button id="runSimButton" fx:id="runSimButton" layoutX="398.0" layoutY="73.0" mnemonicParsing="false" onAction="#runSimulations" text="Run Sim" />
      <BarChart id="runtimeBarChart" fx:id="runtimeBarChart" layoutX="72.0" layoutY="363.0" prefHeight="162.0" prefWidth="184.0" title="Total Runtime">
        <xAxis>
          <CategoryAxis side="BOTTOM" />
        </xAxis>
        <yAxis>
          <NumberAxis side="LEFT" />
        </yAxis>
      </BarChart>
      <BarChart id="nodesBarChart" fx:id="nodesBarChart" layoutX="332.0" layoutY="363.0" prefHeight="162.0" prefWidth="184.0" title="Num. Nodes">
         <xAxis>
            <CategoryAxis side="BOTTOM" />
         </xAxis>
         <yAxis>
            <NumberAxis side="LEFT" />
         </yAxis>
      </BarChart>
      <BarChart id="pathLenBarChart" fx:id="pathLenBarChart" layoutX="68.0" layoutY="547.0" prefHeight="162.0" prefWidth="184.0" title="Path Lenghts">
         <xAxis>
            <CategoryAxis side="BOTTOM" />
         </xAxis>
         <yAxis>
            <NumberAxis side="LEFT" />
         </yAxis>
      </BarChart>
      <BarChart id="successBarChart" fx:id="successBarChart" layoutX="328.0" layoutY="547.0" prefHeight="162.0" prefWidth="184.0" title="Num. Successes">
         <xAxis>
            <CategoryAxis side="BOTTOM" />
         </xAxis>
         <yAxis>
            <NumberAxis side="LEFT" />
         </yAxis>
      </BarChart>
      <TextArea id="textArea" fx:id="textArea" layoutX="50.0" layoutY="148.0" prefHeight="175.0" prefWidth="500.0" />
      <RadioButton id="singleSimRadio" fx:id="singleSimRadio" layoutX="103.0" layoutY="65.0" mnemonicParsing="false" text="Single Simulation" />
      <RadioButton id="batchSimRadio" fx:id="batchSimRadio" layoutX="103.0" layoutY="98.0" mnemonicParsing="false" text="Batch Simulation" />
      <VBox layoutX="672.0" layoutY="174.0" prefHeight="333.0" prefWidth="158.0">
         <children>
             <VBox prefHeight="58.0" prefWidth="162.0">
                 <children>
                     <Label fx:id="uiWidthLabel" text="Width" />
                     <TextField fx:id="widthInput" prefHeight="25.0" prefWidth="67.0" />
                 </children>
             </VBox>
             <VBox prefHeight="58.0" prefWidth="162.0">
                 <children>
                     <Label fx:id="uiHeightLabel" text="Height" />
                     <TextField fx:id="heightInput" prefHeight="25.0" prefWidth="67.0" />
                 </children>
             </VBox>
             <VBox prefHeight="58.0" prefWidth="162.0">
                 <children>
                     <Label fx:id="uiODLabel" text="ObstacleDensity" />
                     <TextField fx:id="odInput" prefHeight="25.0" prefWidth="67.0" />
                 </children>
             </VBox>
             <VBox prefHeight="58.0" prefWidth="162.0">
                 <children>
                     <Label fx:id="uiDynamicLabel" text="dynamicObstacles" />
                  <CheckBox fx:id="dynamicInput" mnemonicParsing="false" text="True?" />
                 </children>
             </VBox>
             <VBox prefHeight="58.0" prefWidth="162.0">
                 <children>
                     <Label fx:id="uiDynamicProbLabel" text="dynamicObstacleMoveProb" />
                     <TextField fx:id="dynamicProbInput" prefHeight="25.0" prefWidth="67.0" />
                 </children>
             </VBox>
             <VBox prefHeight="58.0" prefWidth="162.0">
                 <children>
                     <Label fx:id="uiTicksLabel" text="maxTicks" />
                     <TextField fx:id="ticksInput" prefHeight="25.0" prefWidth="67.0" />
                 </children>
             </VBox>
             <VBox prefHeight="58.0" prefWidth="162.0">
                 <children>
                     <Label fx:id="uiAlgoLabel" text="algo" />
                  <MenuButton fx:id="algoInput" mnemonicParsing="false" text="MenuButton">
                    <items>
                      <MenuItem mnemonicParsing="false" text="Action 1" />
                      <MenuItem mnemonicParsing="false" text="Action 2" />
                    </items>
                  </MenuButton>
                 </children>
             </VBox>
             <VBox prefHeight="58.0" prefWidth="162.0">
                 <children>
                     <Label fx:id="uiSeedLabel" text="seed" />
                     <TextField id="seedInput" fx:id="seedInput" prefHeight="25.0" prefWidth="67.0" />
                 </children>
             </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
